+import config from './config.json';
+import {createProgressStore, consumeResetURL} from './persistence.js';
+import {createCollectibles} from './collectibles.js';
+import {createProgressUI} from './progress-ui.js';
+
+export function createHongqiaoProgress({scene, loader, world, getActor, canOpen, onOpen, onClose, toast}) {
+  const development = import.meta.env.DEV && new URLSearchParams(location.search).has('test');
+  // Access can throw even before getItem (privacy/security settings).
+  const storage = {getItem:key=>localStorage.getItem(key),setItem:(key,value)=>localStorage.setItem(key,value),removeItem:key=>localStorage.removeItem(key)};
+  const reset = consumeResetURL({url:location.href,history,storage,development});
+  const store = createProgressStore({config,storage});
+  if(reset.error)console.error('[Hongqiao reset]',reset.error);
+  const collectibles = createCollectibles({scene,loader,config,store,world,baseURL:import.meta.env.BASE_URL});
+  const ui = createProgressUI({config,store,development,canOpen,onOpen,onClose,toast});
+  if(development)window.__hqProgress={
+    getState:store.getState,getStatus:store.getStatus,getErrors:store.getErrors,getWorld:collectibles.getState,
+    dispatch:store.dispatch,restoreFixture:store.restoreFixture,retrySave:store.retrySave,config,reset,
+  };
+  return {
+    store, ui,
+    prompt() {const focused=collectibles.focus(getActor());return focused ? '取'+focused.item.name : null;},
+    interact() {const focused=collectibles.focus(getActor());if(!focused)return false;const result=store.dispatch({type:'collect',instanceId:focused.instance.id});if(result.changed&&!result.saved)toast('已取得物品，保存失败；请查看提示并重试。');return result.ok;},
+  };
+}
