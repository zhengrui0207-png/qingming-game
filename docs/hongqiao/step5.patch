+    el('small',mode==='closing'?'虹桥急情 · 收尾':'虹桥急情');
+    el('h2',colon>0?line.slice(0,colon):'');el('p',colon>0?line.slice(colon+1):line).id='hq-line';
+    el('small',`${lineIndex+1} / ${n.lines.length}`);
