+"""Project-authored, deterministic PCM foley. No cloud service or sampled external recording."""
+import math,random,wave,struct,json,hashlib,pathlib
+root=pathlib.Path(__file__).resolve().parents[3];out=root/'src/chapter2/presentation/audio';out.mkdir(parents=True,exist_ok=True)
+rate=24000;rows=[]
+settings={'cast':(.65,.15,'Air and line movement'),'bobber':(.2,.13,'Small water plop'),'reel':(1.0,.10,'Line rubbing wood'),'splash':(.85,.18,'Water noise with drops'),'wheel':(1.2,.12,'Wooden wheel rolling'),'coin':(.5,.12,'Two restrained metal ticks'),'steam':(1.1,.08,'Soft steam release'),'bell':(1.2,.12,'Tongued bell only; NEVER the silent story bell')}
+for seed,(name,(length,target,description)) in enumerate(settings.items()):
+ rnd=random.Random(900+seed);smooth=0;data=[]
+ for i in range(int(rate*length)):
+  t=i/rate;n=rnd.uniform(-1,1);smooth=.78*smooth+.22*n;env=min(1,t/.012)*min(1,(length-t)/.07)
+  if name=='cast':v=(.5*smooth+.2*n)*math.sin(math.pi*t/length)**1.6
+  elif name=='bobber':v=math.sin(2*math.pi*(300*t-120*t*t))*math.exp(-24*t)+smooth*.3*math.exp(-18*t)
+  elif name=='reel':v=smooth*(.6+.35*math.sin(2*math.pi*11*t))+.025*math.sin(2*math.pi*85*t)
+  elif name=='splash':v=(smooth+.2*n)*math.exp(-3.2*t)+.15*math.sin(2*math.pi*690*t)*math.exp(-12*t)
+  elif name=='wheel':v=smooth*.35*(.7+.3*math.cos(2*math.pi*7*t))+.17*math.sin(2*math.pi*(100*t+1.6*math.sin(t*13)))*math.sin(math.pi*t/length)
+  elif name=='coin':v=sum(math.sin(2*math.pi*f*(t-offset))*math.exp(-18*(t-offset)) for offset in [0,.16] for f in [1650,2417] if t>=offset)*.4
+  elif name=='steam':v=(n-smooth)*math.sin(math.pi*t/length)**.8*.3
+  else:v=sum(math.sin(2*math.pi*f*t)*math.exp(-d*t)*a for f,d,a in [(770,3,1),(1193,4,.35),(2094,5,.14)])
+  data.append(v*env)
